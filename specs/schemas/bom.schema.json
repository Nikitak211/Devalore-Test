{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/specs/schemas/bom.schema.json",
  "title": "Universal 3D Engineering BOM",
  "type": "object",
  "required": ["project", "manifest_version", "bom"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "manifest_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source": { "type": "string" },
    "printer_family": {
      "type": "string",
      "enum": ["FDM", "SLA", "SLS", "mixed", "unknown"]
    },
    "default_material": { "type": "string" },
    "hole_compensation_mm": { "type": "number" },
    "validation": {
      "type": "object",
      "properties": {
        "expected_component_count": { "type": "integer", "minimum": 0 },
        "bom_matches_manifest": { "type": "boolean" },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "name", "quantity"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": ["integer", "string"] },
          "material_constraint": { "type": "string" },
          "material_override": { "type": "string" },
          "tolerance_test_required": { "type": "boolean" },
          "notes": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
