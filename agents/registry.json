{
  "framework": "Sol 5.6 Max Master 3D Engineering Orchestrator",
  "orchestrator": ".cursorrules",
  "agents": [
    {
      "id": "ingestion",
      "role": "Text/Image Parser & Manifest Validator",
      "prompt": "agents/ingestion.md",
      "writes": ["specs/bom/", "specs/manifests/", "specs/dependencies/"]
    },
    {
      "id": "dfm-slicing",
      "role": "Geometric Slicing & Volumetric Optimization Engineer",
      "prompt": "agents/dfm-slicing.md",
      "writes": ["specs/dfm/", "outputs/slicing/"]
    },
    {
      "id": "kinematics-assembly",
      "role": "Mechanical Assembly Logic & Tolerancing Engineer",
      "prompt": "agents/kinematics-assembly.md",
      "writes": [
        "specs/dependencies/",
        "outputs/assembly/",
        "outputs/tolerance/"
      ]
    }
  ],
  "pipeline": ["ingestion", "dfm-slicing", "kinematics-assembly", "consolidation"]
}
