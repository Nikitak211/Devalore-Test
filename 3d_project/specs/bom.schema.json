{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/3d_project/specs/bom.schema.json",
  "title": "Universal JSON BOM Schema (Sol 5.6 Max PyOrch)",
  "type": "object",
  "required": ["project_metadata", "components"],
  "properties": {
    "project_metadata": {
      "type": "object",
      "required": ["project_name", "orchestrator_version"],
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string" },
        "orchestrator_version": { "type": "string" },
        "parser_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "name", "quantity", "manufacturing"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^COMP-[A-Z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "raw_text_context": { "type": "string" },
          "manufacturing": {
            "type": "object",
            "required": [
              "material_hint",
              "mechanical_profile",
              "requires_tolerance_tuning"
            ],
            "properties": {
              "material_hint": {
                "type": "string",
                "enum": ["PLA", "PETG", "ABS", "TPU", "NYLON", "ASA", "RESIN"]
              },
              "mechanical_profile": {
                "type": "string",
                "enum": ["load-bearing", "structural", "compliant", "cosmetic"]
              },
              "requires_tolerance_tuning": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "assembly_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_number", "instruction"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "prerequisite_components": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
